; ------------------------- ;
; IF YOU KNOW A LOT ABOUT
; WINDOZE DRIVERS, THEN U
; WILL KNOW THAT ALMOST ALL
; OF THEN COME WITH A .INF
; FILE, IT CAN INSTALL THEM.
; 
; SO I WILL BE USING A .INF
; FILE TO INSTALL THE OS.
;
; SOMETHIN' MALWAREPAD 
; FORGOT >:)
; ------------------------- ;

[AUTORUN]
OPEN="BOOTXF.BIN"
ICON="DISK.ICO"
LABEL="TAIAMÃ DISK."

; ----------------------------------------------------  ;
; THE "XF" IN THE FINAL MEANS "EXCLUSIVE FINAL", SINCE
; ITS NOT INCLUDED IN THE SOURCE FOLDER, AS IT IS NOT
; FOR DEVELOPERS BUT FOR THE MACHINE.
; ----------------------------------------------------- ;

[VERSION]
SIGNATURE="$Windows NT$"
CLASS       = SYSTEM
CLASSGUID   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
PROVIDER    = %TAIAMA%
DRIVERVER   = 08/14/2026,1.0.0.0

[MANUFACTURER]
%TAIAMA% = DEVICELIST, NTAMD64

[DEVICELIST.NTAMD64]
%TDESC% = INSTALLSECTION, PCI\VEN_1234&DEV_5678

[INSTALLSECTION.NTAMD64]
COPYFILES = DRIVERCOPYFILES

[DRIVERCOPYFILES]
DEPLOY.SYS

[STRINGS]
TAIAMA = "Taiamã Whirlpool 0.01"
TDESC = "Taiama installation disk."